server {
    listen 80 default_server;
    server_name _;

    root /var/www/p44-banco-de-sangre;
    index index.html;

    location = / { return 302 /app/; }
    location = /dashboard/ { return 302 /app/#inventario; }
    location = /detalle_unidad/ { return 302 /app/#procesos; }
    location = /bitacora/ { return 302 /app/#bitacora; }
    location /app/ { try_files $uri $uri/ =404; }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /metrics {
        proxy_pass http://127.0.0.1:8080;
    }

    location / { return 404; }
}
