{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p44_banco_de_sangre]}
]}.

{relx, [
  %% cowboy/cowlib/ranch van explicitos aqui, aunque relx deberia resolverlos solo
  %% via la lista 'applications' de cada .app (dependencia transitiva): listarlos
  %% a mano es mas facil de verificar a ojo y no depende de esa resolucion automatica.
  {release, {p44_banco_de_sangre, "0.1.0"},
   [p44_banco_de_sangre, sasl, recon, cowboy, cowlib, ranch]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
